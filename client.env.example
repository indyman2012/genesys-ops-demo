# Genesys OAuth (required for all ops tools)
GENESYS_CLIENT_ID=your_client_id
GENESYS_CLIENT_SECRET=your_client_secret
GENESYS_REGION=usw2

# Optional overrides
# GENESYS_API_BASE=https://api.usw2.pure.cloud
# GENESYS_LOGIN_BASE=https://login.usw2.pure.cloud

# MySQL (dashboards/jobs — not needed for ops tool validation)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=genesys
MYSQL_USER=root
MYSQL_PASSWORD=password
