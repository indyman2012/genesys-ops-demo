# GenesysCloudToolkit email settings
# Copy to email.env in the project root (gitignored via *.env).
#
# Local dev (personal Gmail): keep using doug.env — no email.env required.
# Work hosts / Azure App Service: copy this file to email.env or set these as app settings.

# --- Office 365 (Archwell) — recommended after cutover ---
EMAIL_PROVIDER=office365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Authenticated mailbox (UPN). For shared mailboxes, use the delegated login.
SMTP_USER=your.name@archwellhealth.com
SMTP_PASSWORD=

# From address (usually matches SMTP_USER; may be a permitted send-as alias)
SMTP_FROM=your.name@archwellhealth.com
FROM_NAME=GenesysCloudToolkit Reports

# --- Gmail fallback (local dev) — use doug.env instead, or uncomment below ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# USER=your.personal@gmail.com
# PASSWORD=your-16-char-app-password
# FROM_NAME=Doug Hendrickson - Cursor Report Engine
